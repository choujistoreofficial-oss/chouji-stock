# Nomerin — simpan di Vercel Environment Variables, jangan di frontend/GitHub
NOMERIN_API_KEY=
NOMERIN_BASE_URL=https://api.nomerin.id
NOMERIN_WEBHOOK_SECRET=

# Token internal untuk mengunci endpoint proxy agar tidak bisa dipakai publik sembarangan.
# Buat nilai acak panjang (minimal 32 karakter), simpan hanya di Vercel.
CHOUJI_INTERNAL_API_TOKEN=

# Supabase server-side secret (gunakan nama yang sesuai dengan env project Anda)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
